---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const notFound = dict.notFound;
---

<Layout title={notFound.title} description={notFound.description} noindex>
  <Header />
  <main class="flex items-center justify-center min-h-screen bg-white dark:bg-gray-900">
    <div class="text-center px-4 py-24">
      <p class="text-8xl sm:text-9xl font-bold text-primary-500 dark:text-primary-400">404</p>
      <h1 class="mt-6 text-3xl font-bold text-gray-900 dark:text-white mb-4">{notFound.heading}</h1>
      <p class="text-gray-600 dark:text-gray-300 mb-8 max-w-md mx-auto">{notFound.message}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={getPath(locale, '/')} class="btn-primary">{notFound.returnHome}</a>
        <a href={getPath(locale, '/contact')} class="btn-outline">{notFound.contact}</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>