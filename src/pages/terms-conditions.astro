---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, getLocaleFromPath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const terms = dict.legal.terms;
---

<Layout title={terms.title} description={terms.description}>
  <Header />
  <main class="pt-32 pb-20 bg-white dark:bg-gray-900">
    <div class="container-custom max-w-3xl">
      <h1 class="text-3xl md:text-4xl font-bold mb-8 text-gray-900 dark:text-white">{terms.heading}</h1>
      <div class="space-y-8">
        {terms.sections.map((section) => (
          <section>
            <h2 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white">{section.title}</h2>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{section.body}</p>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>