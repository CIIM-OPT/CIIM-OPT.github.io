---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HeroSection from '../../../components/HeroSection.astro';
import PublicationsList from '../../../components/PublicationsList.astro';
import { getDict } from '../../../lib/i18n';

const dict = getDict('en');
---

<Layout title={dict.publicationsPage.title} description={dict.publicationsPage.description}>
  <Header />
  <main>
    <HeroSection
      title={dict.publicationsPage.heroTitle}
      highlightText={dict.publicationsPage.heroHighlight}
      description={dict.publicationsPage.heroSubtitle}
    />
    <section class="section bg-white dark:bg-gray-900">
      <div class="container-custom">
        <PublicationsList />
      </div>
    </section>
  </main>
  <Footer />
</Layout>