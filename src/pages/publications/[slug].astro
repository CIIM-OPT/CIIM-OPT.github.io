---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PubDetail from '../../components/PublicationDetail.astro';
import { getDict, getLocaleFromPath } from '../../lib/i18n';
import { scholarlyArticleSchema } from '../../lib/schema';
import type { Publication } from '../../lib/i18n';

export interface Props {
  pub: Publication;
}

export function getStaticPaths() {
  return getDict('es').publications.map((pub) => ({ params: { slug: pub.id }, props: { pub } }));
}

const { pub } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const jsonLd = scholarlyArticleSchema(pub);
---

<Layout title={pub.title} description={pub.description} jsonLd={jsonLd}>
  <Header />
  <main>
    <PubDetail pub={pub} />
  </main>
  <Footer />
</Layout>