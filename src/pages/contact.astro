---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import Contact from '../components/Contact.astro';
import { getDict, getLocaleFromPath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
---

<Layout title={dict.contactPage.title} description={dict.contactPage.description}>
  <Header />
  <main>
    <HeroSection
      title={dict.contactPage.heroTitle}
      highlightText={dict.contactPage.heroHighlight}
      description={dict.contactPage.heroSubtitle}
    />
    <Contact />
  </main>
  <Footer />
</Layout>