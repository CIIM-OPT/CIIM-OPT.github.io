---
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';
import type { Publication } from '../lib/i18n';

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const detail = dict.publicationDetail;
---

<div class="pt-32 pb-20 bg-white dark:bg-gray-900">
  <div class="container-custom max-w-3xl">
    <a href={getPath(locale, '/publications')} class="inline-flex items-center text-primary-600 dark:text-primary-400 font-medium mb-8 hover:underline">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      {detail.back}
    </a>

    <article>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 text-sm font-medium">{pub.journal}</span>
        <span class="text-sm text-gray-500 dark:text-gray-400">{pub.year}</span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold leading-tight text-gray-900 dark:text-white mb-6">{pub.title}</h1>

      <p class="text-gray-600 dark:text-gray-300 mb-6">
        <span class="font-medium text-gray-800 dark:text-gray-200">{pub.author}</span>
      </p>

      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{detail.abstract}</h2>
      <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-6">{pub.description}</p>

      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">{detail.keywords}</h2>
      <div class="flex flex-wrap gap-2 mb-8">
        {pub.keywords.map((keyword) => (
          <span class="px-3 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 text-sm">
            {keyword}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap gap-4">
        <a href={pub.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
          {detail.viewFullArticle}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="btn-outline">
          DOI: {pub.doi}
        </a>
      </div>
    </article>
  </div>
</div>