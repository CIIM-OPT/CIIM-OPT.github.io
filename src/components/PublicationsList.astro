---
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const publications = dict.publications;
const detail = dict.publicationDetail;
---

<div class="grid md:grid-cols-2 gap-8">
  {publications.map((pub) => (
    <article class="card p-6 flex flex-col border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between mb-3 gap-4">
        <span class="text-xs font-medium text-secondary-500 uppercase tracking-wide">{pub.journal}</span>
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400 shrink-0">{pub.year}</span>
      </div>

      <h2 class="text-lg font-semibold leading-snug mb-3">
        <a href={getPath(locale, `/publications/${pub.id}`)} class="text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
          {pub.title}
        </a>
      </h2>

      <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">{pub.description}</p>

      <div class="flex flex-wrap gap-2 mb-5">
        {pub.keywords.map((keyword) => (
          <span class="px-2 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 text-xs">
            {keyword}
          </span>
        ))}
      </div>

      <a
        href={pub.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-auto text-primary-600 dark:text-primary-400 font-medium text-sm hover:underline"
      >
        {detail.viewFullArticle}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </article>
  ))}
</div>