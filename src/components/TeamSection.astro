---
import { getDict, getLocaleFromPath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const team = dict.teamPage;

const director = team.members.find((m) => m.roleKey === 'director');
const assistants = team.members.filter((m) => m.roleKey === 'assistant');
const researchers = team.members.filter((m) => m.roleKey !== 'director' && m.roleKey !== 'assistant');

const gridClass = 'grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12';
---

<section class="py-16 bg-white dark:bg-gray-800">
  <div class="container-custom">
    {director && (
      <div class="text-center mb-16">
        <div class="card p-8 inline-block max-w-sm border border-gray-200 dark:border-gray-700">
          <img src={director.image} width="112" height="112" alt={director.name} class="w-28 h-28 rounded-full mx-auto mb-4 object-cover" />
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-1">{director.name}</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">{director.role}</p>
          <a href={director.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-600 dark:hover:text-primary-400 transition-colors" aria-label={`${director.name} LinkedIn`}>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        </div>
      </div>
    )}

    {assistants.length > 0 && (
      <>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">{team.assistantsLabel}</h3>
        <div class={gridClass}>
          {assistants.map((member) => (
            <div class="card p-6 text-center border border-gray-200 dark:border-gray-700">
              <img src={member.image} width="64" height="64" alt={member.name} class="w-16 h-16 rounded-full mx-auto mb-4 object-cover" />
              <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">{member.name}</h4>
              <p class="text-gray-600 dark:text-gray-300 mb-3">{member.role}</p>
              <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 font-medium text-sm hover:underline">LinkedIn</a>
            </div>
          ))}
        </div>
      </>
    )}

    {researchers.length > 0 && (
      <>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">{team.teamLabel}</h3>
        <div class={gridClass}>
          {researchers.map((member) => (
            <div class="card p-6 text-center border border-gray-200 dark:border-gray-700">
              <img src={member.image} width="64" height="64" alt={member.name} class="w-16 h-16 rounded-full mx-auto mb-4 object-cover" />
              <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">{member.name}</h4>
              <p class="text-gray-600 dark:text-gray-300 mb-3">{member.role}</p>
              <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 font-medium text-sm hover:underline">LinkedIn</a>
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</section>