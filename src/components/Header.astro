---
import logoWhite from '../assets/ciim_white.svg';
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const switchUrl = locale === 'es' ? getPath('en', Astro.url.pathname) : `/${Astro.url.pathname.replace(/^\/en/, '')}`;

const nav = [
  { label: dict.nav.home, path: '/' },
  { label: dict.nav.research, path: '/research' },
  { label: dict.nav.ifmsa, path: '/ifmsa' },
  { label: dict.nav.publications, path: '/publications' },
  { label: dict.nav.team, path: '/team' },
  { label: dict.nav.contact, path: '/contact' },
];

const isActive = (path: string) => {
  const current = Astro.url.pathname.replace(/\/$/, '');
  const target = path === '/' ? (locale === 'es' ? '' : '/en') : getPath(locale, path).replace(/\/$/, '');
  return current === target;
};
---

<header class="fixed w-full bg-primary-950/95 backdrop-blur-xs z-50 py-4 border-b border-white/10">
  <div class="container-custom flex items-center justify-between">
    <a href={getPath(locale, '/')} class="flex items-center" aria-label={dict.nav.home}>
      <img src={logoWhite.src} class="h-10 w-auto" width="40" height="40" alt="CIIM Logo">
    </a>

    <nav class="hidden md:flex items-center space-x-8" aria-label={dict.nav.home}>
      {nav.map((item) => (
        <a
          href={getPath(locale, item.path)}
          aria-current={isActive(item.path) ? 'page' : undefined}
          class:list={[
            isActive(item.path)
              ? 'text-white font-semibold'
              : 'text-white/70 hover:text-accent-300',
            'text-sm font-medium transition-colors',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center space-x-4">
      <a
        href={switchUrl}
        class="hidden sm:inline-flex items-center px-3 py-1.5 rounded-full border border-white/25 text-xs font-medium text-white/80 hover:text-accent-300 hover:border-accent-300/60 transition-colors"
      >
        {dict.nav.language}
      </a>

      <button
        x-on:click="darkMode = !darkMode"
        class="p-2 rounded-full text-white/70 hover:text-white dark:text-white/70 focus:outline-hidden focus:ring-2 focus:ring-accent-400"
        aria-label="Toggle dark mode"
      >
        <svg x-show="!darkMode" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg x-show="darkMode" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <div x-data="{ open: false }">
        <button
          @click="open = !open"
          class="md:hidden p-2 rounded-md text-white/70 hover:text-white focus:outline-hidden focus:ring-2 focus:ring-accent-400"
          aria-label="Toggle menu"
        >
          <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg x-show="open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div
          x-show="open"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="absolute top-16 right-4 w-48 py-2 bg-primary-950 rounded-md shadow-lg ring-1 ring-white/10 focus:outline-hidden"
          x-cloak
        >
          {nav.map((item) => (
            <a href={getPath(locale, item.path)} class="block px-4 py-2 text-sm text-white/80 hover:bg-white/10 hover:text-white">
              {item.label}
            </a>
          ))}
          <a href={switchUrl} class="block px-4 py-2 text-sm text-white/80 hover:bg-white/10 hover:text-white">
            {dict.nav.language}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  [x-cloak] { display: none !important; }
</style>