---
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const projects = dict.ifmsaProjects;
---

<section class="section bg-gray-50 dark:bg-gray-800/50">
  <div class="container-custom">
    <div class="grid md:grid-cols-3 gap-8">
      {projects.map((project, index) => (
        <div
          class="card p-6 border-gray-200 dark:border-gray-700 slide-up relative flex flex-col"
          style={`animation-delay: ${index * 150}ms`}
        >
          {project.popular && (
            <div class="absolute top-0 right-0 bg-secondary-500 text-white px-4 py-1 text-sm font-medium rounded-bl-lg rounded-tr-lg">
              {index === 0 ? 'Featured' : ''}
            </div>
          )}

          <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white">{project.name}</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6">{project.description}</p>

          <ul class="space-y-3 mb-8">
            {project.features.map((feature) => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-secondary-500 mr-2 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-gray-600 dark:text-gray-300">{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full btn-outline mt-auto"
          >
            {dict.ifmsaPage.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-gray-600 dark:text-gray-300 mb-2">{dict.ifmsaPage.needAdvice}</p>
      <a href={getPath(locale, '/contact')} class="text-primary-600 dark:text-primary-400 font-medium hover:underline">
        {dict.ifmsaPage.contactTeam}
      </a>
    </div>
  </div>
</section>