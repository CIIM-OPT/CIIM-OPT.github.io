---
import { site } from '../lib/config';
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const currentYear = new Date().getFullYear();

const columns = [
  {
    title: dict.nav.home,
    links: [
      { text: dict.nav.home, path: '/' },
      { text: dict.nav.research, path: '/research' },
      { text: dict.nav.contact, path: '/contact' },
    ],
  },
  {
    title: dict.nav.publications,
    links: [
      { text: dict.nav.publications, path: '/publications' },
      { text: dict.nav.ifmsa, path: '/ifmsa' },
      { text: dict.nav.team, path: '/team' },
    ],
  },
];
---

<footer class="bg-primary-950 text-white pt-16 pb-8">
  <div class="container-custom">
    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div>
        <a href={getPath(locale, '/')} class="flex items-center mb-6" aria-label={dict.nav.home}>
          <span class="text-xl font-display font-semibold text-white">CIIM</span>
        </a>
        <p class="text-gray-400 mb-6 max-w-md">{dict.footer.tagline}</p>
        <div class="flex space-x-4">
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors" aria-label="GitHub">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
        </div>
      </div>

      {columns.map((column) => (
        <div>
          <h3 class="text-lg font-semibold mb-4">{column.title}</h3>
          <ul class="space-y-2">
            {column.links.map((link) => (
              <li>
                <a href={getPath(locale, link.path)} class="text-gray-400 hover:text-primary-400 transition-colors">{link.text}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-lg font-semibold mb-4">{dict.footer.followUs}</h3>
        <ul class="space-y-2">
          <li>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors">GitHub</a>
          </li>
          <li>
            <a href={site.parentOrgUrl} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary-400 transition-colors">{site.university}</a>
          </li>
        </ul>
        <p class="text-gray-500 text-sm mt-4">{site.email}</p>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 mt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <p class="text-gray-400 text-sm mb-4 md:mb-0">
          &copy; {currentYear} {dict.footer.rights}
        </p>
        <div class="flex space-x-6">
          <a href={getPath(locale, '/privacy-policy')} class="text-gray-400 hover:text-primary-400 text-sm transition-colors">{dict.footer.privacy}</a>
          <a href={getPath(locale, '/terms-conditions')} class="text-gray-400 hover:text-primary-400 text-sm transition-colors">{dict.footer.terms}</a>
        </div>
      </div>
    </div>
  </div>
</footer>