---
import { site } from '../lib/config';
import { getDict, getLocaleFromPath, getPath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const locale: Locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDict(locale);
const hero = dict.home.hero;
---

<section class="relative pt-32 pb-20 md:pt-40 overflow-hidden hero-section">
  <div class="container-custom relative z-10">
    <div class="slide-up" transition:animate="slide">
      <h1 class="mb-6 text-secondary-900 dark:text-white leading-tight">
        <span class="text-primary-800 dark:text-primary-300">{hero.titleStart}<br></span>{hero.titleEnd}
      </h1>
      <p class="text-xl text-secondary-600 dark:text-secondary-300 mb-8 max-w-lg">
        {hero.subtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={getPath(locale, '/contact')} class="btn-primary">
          {hero.contact}
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn-outline flex items-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          {hero.repo}
        </a>
      </div>
    </div>
  </div>
</section>